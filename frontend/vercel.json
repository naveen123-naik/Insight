{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://insight-1-vf6e.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {},
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "x-proxy-target",
          "value": "render-backend"
        }
      ]
    }
  ]
}
